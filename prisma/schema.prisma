// Prisma schema for Net Terms Receivables Shopify App
// Uses Supabase Postgres Free (Seoul, ap-northeast-2) via Cloudflare Hyperdrive
//
// IMPORTANT: Prisma is used ONLY for schema definition and migrations.
// Runtime queries use postgres.js directly (app/lib/db-light.server.ts) to keep
// the Worker bundle small (<400 KiB gzipped).
//
// Migrations run from CI over Supabase's Supavisor SESSION pooler (port 5432)
// Worker connects through Hyperdrive binding (pooled)

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  runtime  = "cloudflare"
}

generator client_node {
  provider = "prisma-client"
  output   = "../app/generated/prisma-node"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

/// Type of buyer account: B2B Company or tagged Customer
enum AccountKind {
  COMPANY
  TAGGED_CUSTOMER
}

/// Credit hold state for a buyer account
enum HoldState {
  OK
  NEAR_LIMIT
  HELD
  BYPASS
}

/// Source of default terms for a buyer account
enum DefaultTermsSource {
  explicit
  tag
}

/// Source category for invoice due date (matches due-date.ts output)
enum DueSource {
  schedule
  override
  inferred
  none
}

/// Status of an invoice
enum InvoiceStatus {
  open
  paid
  cancelled
}

/// Status of a payment (bank credit)
enum PaymentStatus {
  unmatched
  partial
  matched
}

/// State of a payment-invoice match
enum MatchState {
  suggested
  confirmed
  pushed
  unmatched
}

/// Channel for sending reminders
enum ReminderChannel {
  native
  email
}

// =============================================================================
// SESSION STORAGE (existing, DO NOT MODIFY)
// =============================================================================

/// Shopify OAuth session storage
/// Used by app/lib/session-storage-light.server.ts (postgres.js implementation)
///
/// PII note: firstName, lastName, and email columns are populated only for
/// online sessions (isOnline=true). Offline sessions (used for background jobs)
/// do not contain user PII. Handle per your GDPR/CCPA compliance requirements.
///
/// IMPORTANT: This table uses TIMESTAMP(3) columns (not TIMESTAMPTZ) for historical
/// compatibility. LightSessionStorage reads/writes them with AT TIME ZONE 'UTC'.
/// DO NOT change the column types or the session storage will break.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean   @default(false)
  emailVerified       Boolean   @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  // Index for efficient lookup when deleting all sessions for a shop (DPDP compliance)
  @@index([shop])
}

// =============================================================================
// SHOP & ACCOUNT CONFIGURATION
// =============================================================================

/// Merchant shop configuration
/// Created when a shop installs the app; deleted on uninstall (S22)
model Shop {
  id               String    @id @default(dbgenerated("gen_random_uuid()::text"))
  /// Shopify shop domain (e.g. "example.myshopify.com")
  domain           String    @unique
  /// Default currency for the shop
  currency         String    @default("INR")
  /// Subscription plan (legacy, superseded by plan_key)
  plan             String    @default("free")
  /// Shop-level default terms days (last fallback in S9 inference)
  defaultTermsDays Int?
  /// IANA timezone for calendar-day calculations (e.g. "Asia/Kolkata")
  /// Used by due-date.ts for computing end-of-day and adding calendar days
  timezone         String    @default("Asia/Kolkata")
  /// When the shop installed the app
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  /// When shop settings were last updated (set by trigger)
  updatedAt        DateTime  @default(now()) @db.Timestamptz(3)
  /// When the shop uninstalled the app (S22). NULL means still installed.
  /// Full data deletion happens on shop/redact (48h later per Shopify docs).
  uninstalledAt    DateTime? @db.Timestamptz(3)

  // S21: Plan cache columns
  /// Cached plan key (free, starter, growth, scale). Defaults to free.
  planKey          String    @default("free") @map("plan_key")
  /// Shopify subscription GID from activeSubscriptions query.
  subscriptionId   String?   @map("subscription_id")
  /// Subscription name from Shopify (maps to plan_key).
  subscriptionName String?   @map("subscription_name")
  /// Whether this is a test/development subscription.
  isTest           Boolean   @default(false) @map("is_test")
  /// When the plan cache was last refreshed. TTL ~6h.
  planCachedAt     DateTime? @map("plan_cached_at") @db.Timestamptz(3)

  // Relations - direct children with CASCADE
  accounts     BuyerAccount[]
  sources      AccountSource[]
  imports      BankImport[]
  rules        ReminderRule[]
  auditEvents  AuditEvent[]
  // Direct CASCADE relations to enable Shop delete when financial records exist
  // These rows are deleted before their parents (BuyerAccount, BankImport, etc.)
  invoices     Invoice[]
  payments     Payment[]
  matches      Match[]
  reminderLogs ReminderLog[]

  // S21: Index for finding shops by plan (analytics, batch operations)
  @@index([planKey])
}

/// Tag rule for non-B2B wholesale (tagged customer accounts)
/// Maps customer tags to default payment terms
model AccountSource {
  id               String @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId           String
  /// Customer tag to match (e.g. "net30", "wholesale-gold")
  tag              String
  /// Default payment terms in days when this tag matches
  defaultTermsDays Int
  /// When the rule was created
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  /// When the rule was last updated (set by trigger)
  updatedAt        DateTime @default(now()) @db.Timestamptz(3)

  // Relations (onDelete: CASCADE - tag rules are shop-specific configuration)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // One tag rule per tag per shop
  @@unique([shopId, tag])
  @@index([shopId])
}

/// Buyer account: either a B2B Company/CompanyLocation or a tagged Customer
/// Represents an entity that can receive invoices and make payments
///
/// CHECK constraint enforces kind consistency:
/// - COMPANY requires companyLocationId (and companyId)
/// - TAGGED_CUSTOMER requires customerId
model BuyerAccount {
  id                  String             @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId              String
  /// Type of buyer: B2B company or tagged customer
  kind                AccountKind
  /// Shopify Company GID (for COMPANY accounts)
  companyId           String?
  /// Shopify CompanyLocation GID (for COMPANY accounts)
  companyLocationId   String?
  /// Shopify Customer GID (for TAGGED_CUSTOMER accounts)
  customerId          String?
  /// Display name for the account
  name                String
  /// Credit limit in shop currency (null = no limit)
  creditLimit         Decimal?           @db.Decimal(14, 2)
  /// Account-specific default payment terms in days
  defaultTermsDays    Int?
  /// Source of the default terms: explicit (set by merchant) or tag (copied from tag rule)
  /// A tag-copied default counts as tag-derived for S9 inference precedence
  defaultTermsSource  DefaultTermsSource?
  /// Credit hold state
  holdState           HoldState          @default(OK)
  /// Manual bypass for credit hold (overrides holdState)
  bypass              Boolean            @default(false)
  /// When the account was created
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  /// When the account was last updated (set by trigger)
  updatedAt           DateTime           @default(now()) @db.Timestamptz(3)
  /// S21: When this account was gated due to plan limits. NULL means active.
  /// Gated accounts are excluded from limit count and enforcement.
  gatedAt             DateTime?          @map("gated_at") @db.Timestamptz(3)

  // Relations (onDelete: CASCADE - accounts are shop-specific)
  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Invoices use NoAction to prevent silent deletion of financial history
  invoices Invoice[]
  // Aliases can cascade - they're just helper data
  aliases  PayerAlias[]

  // Composite unique for cross-shop integrity (enables composite FKs)
  @@unique([id, shopId])
  // B2B: one account per company location per shop
  // Tagged: one account per customer per shop
  // nulls are distinct in unique constraints, so these work correctly
  @@unique([shopId, companyLocationId])
  @@unique([shopId, customerId])
  @@index([shopId, kind])
  @@index([shopId, holdState])
  // S21: Index for finding gated accounts for reactivation on upgrade
  @@index([gatedAt])
}

// =============================================================================
// INVOICES & PAYMENTS
// =============================================================================

/// Invoice from an order or draft order
/// Tracks outstanding amounts and payment status
///
/// CHECK constraints:
/// - 0 <= outstanding <= total
/// - Exactly one of orderId/draftOrderId must be set
model Invoice {
  id              String        @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId          String
  buyerAccountId  String
  /// Shopify Order GID (mutually exclusive with draftOrderId)
  orderId         String?       @unique
  /// Shopify DraftOrder GID (mutually exclusive with orderId)
  draftOrderId    String?       @unique
  /// Invoice display name (e.g. "#1234")
  name            String
  /// GST invoice number (Indian tax compliance)
  gstInvoiceNo    String?
  /// Total invoice amount in shop currency
  total           Decimal       @db.Decimal(14, 2)
  /// Outstanding amount in shop currency
  outstanding     Decimal       @db.Decimal(14, 2)
  /// When the invoice was issued
  issuedAt        DateTime      @db.Timestamptz(3)
  /// Computed due date (result of S9 inference or Shopify schedule)
  dueAt           DateTime?     @db.Timestamptz(3)
  /// Source category of the due date (matches due-date.ts DueSource)
  dueSource       DueSource     @default(none)
  /// Basis for inferred due dates: accountDefault, tagRule, shopDefault,
  /// paymentTermsDueInDays (for computed NET/FIXED), or null
  /// Allows the UI to label where the due date came from
  dueBasis        String?
  /// Human-readable explanation of due date inference (from due-date.ts reason)
  dueReason       String?
  /// Merchant override for due date (S9: never beats a Shopify schedule)
  /// Applied only to inferred dates or when no schedule dueAt exists
  dueOverrideAt   DateTime?     @db.Timestamptz(3)
  /// Invoice status
  status          InvoiceStatus @default(open)
  /// When the invoice was created in our system
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  /// When the invoice was last updated (set by trigger)
  updatedAt       DateTime      @default(now()) @db.Timestamptz(3)

  // Relations
  // Direct Shop FK with CASCADE enables Shop delete to work
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Composite FK ensures invoice belongs to same shop as account
  // NoAction: deleting an account with invoices is rejected (preserves financial history)
  account     BuyerAccount  @relation(fields: [buyerAccountId, shopId], references: [id, shopId], onDelete: NoAction)
  // Matches use NoAction to prevent silent deletion of allocations
  allocations Match[]
  // ReminderLogs use NoAction to prevent silent deletion
  reminders   ReminderLog[]

  // Composite unique for cross-shop integrity (enables composite FKs)
  @@unique([id, shopId])
  // Index for common queries: open invoices by shop, sorted by due date
  @@index([shopId, status, dueAt])
  // Index for finding invoices by account
  @@index([buyerAccountId, status])
}

/// Bank statement import (HDFC, ICICI, or mapped format)
/// Groups payments from a single import operation
model BankImport {
  id        String    @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId    String
  /// Bank type: hdfc, icici, or mapped (normalized format)
  bank      String
  /// Original file name
  fileName  String
  /// Number of rows/credits in the import
  rowCount  Int
  /// When the import was performed
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  // Relations (onDelete: CASCADE - imports are shop-specific)
  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Payments use NoAction to prevent silent deletion of financial history
  payments Payment[]

  // Composite unique for cross-shop integrity (enables composite FKs)
  @@unique([id, shopId])
  @@index([shopId, createdAt])
}

/// Payment: one bank credit from a statement import
/// May match to one or more invoices
///
/// CHECK constraint: amount > 0
///
/// DPDP/Privacy note: narration and payerText contain raw bank statement data
/// which may include payer names and identifiers. The customers/redact webhook
/// handler (S22) will need to redact these fields for the affected customer.
/// See GitHub issue #22 for S22 implementation.
model Payment {
  id         String        @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId     String
  importId   String
  /// Value date from the bank statement
  valueDate  DateTime      @db.Timestamptz(3)
  /// Payment amount in shop currency
  amount     Decimal       @db.Decimal(14, 2)
  /// Payment rail: NEFT, RTGS, IMPS, UPI, CLG
  rail       String?
  /// Unique Transaction Reference (bank transaction ID)
  utr        String?
  /// Payer name/text from the bank statement (may contain PII - see DPDP note)
  payerText  String?
  /// Full narration from the bank statement (may contain PII - see DPDP note)
  narration  String
  /// Payment matching status
  status     PaymentStatus @default(unmatched)
  /// When the payment was imported
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  /// When the payment was last updated (set by trigger)
  updatedAt  DateTime      @default(now()) @db.Timestamptz(3)

  // Relations
  // Direct Shop FK with CASCADE enables Shop delete to work
  shop    Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Composite FK ensures payment belongs to same shop as import
  // NoAction: deleting an import with payments is rejected (preserves financial history)
  import  BankImport @relation(fields: [importId, shopId], references: [id, shopId], onDelete: NoAction)
  // Matches use NoAction to prevent silent deletion of allocations
  matches Match[]

  // Composite unique for cross-shop integrity (enables composite FKs)
  @@unique([id, shopId])
  // UTR is unique per shop (prevents duplicate imports)
  // Nullable UTR is allowed (some payments don't have UTR)
  @@unique([shopId, utr])
  @@index([shopId, status])
  @@index([importId])
}

/// Match: payment-to-invoice allocation (confirm-only model)
/// Links a payment to an invoice with amount and confidence
///
/// CHECK constraints:
/// - amount > 0
/// - score between 0 and 100
///
/// shopId ensures payment and invoice are from the same shop via composite FKs
model Match {
  id          String     @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId      String
  paymentId   String
  invoiceId   String
  /// Amount allocated from this payment to this invoice
  amount      Decimal    @db.Decimal(14, 2)
  /// Matching confidence score (0-100)
  score       Int
  /// Reasons for the match (algorithm details, matched fields)
  reasons     Json
  /// Match state: suggested by algorithm, confirmed by user, pushed to Shopify
  state       MatchState @default(suggested)
  /// Who confirmed the match (user ID or "auto")
  confirmedBy String?
  /// When the match was confirmed
  confirmedAt DateTime?  @db.Timestamptz(3)
  /// When the match was created
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  /// When the match was last updated (set by trigger)
  updatedAt   DateTime   @default(now()) @db.Timestamptz(3)

  // Relations
  // Direct Shop FK with CASCADE enables Shop delete to work
  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Composite FKs ensure payment and invoice are from the same shop
  // NoAction: deleting a payment/invoice with matches is rejected
  payment Payment @relation(fields: [paymentId, shopId], references: [id, shopId], onDelete: NoAction)
  invoice Invoice @relation(fields: [invoiceId, shopId], references: [id, shopId], onDelete: NoAction)

  @@index([paymentId])
  @@index([invoiceId])
  @@index([shopId])
}

/// Payer alias: maps narration tokens to buyer accounts
/// Used by the matching algorithm to recognize payers
model PayerAlias {
  id             String @id @default(dbgenerated("gen_random_uuid()::text"))
  buyerAccountId String
  /// Normalized narration token (lowercase, common prefixes stripped)
  payerKey       String
  /// When the alias was created
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  // Relations (onDelete: CASCADE - aliases are helper data, not financial records)
  account BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  // One alias per payer key per account
  @@unique([buyerAccountId, payerKey])
  @@index([payerKey])
}

// =============================================================================
// REMINDERS
// =============================================================================

/// Reminder rule: when to send reminders relative to invoice due date
model ReminderRule {
  id         String          @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId     String
  /// Days offset from due date: negative = before, 0 = on due, positive = after
  /// e.g. -3 = 3 days before due, 7 = 7 days overdue
  offsetDays Int
  /// Channel to send the reminder
  channel    ReminderChannel
  /// Whether the rule is active
  enabled    Boolean         @default(true)
  /// When the rule was created
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  /// When the rule was last updated (set by trigger)
  updatedAt  DateTime        @default(now()) @db.Timestamptz(3)

  // Relations (onDelete: CASCADE - rules are shop-specific config)
  shop Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Logs use NoAction to prevent silent deletion of reminder history
  logs ReminderLog[]

  // Composite unique for cross-shop integrity (enables composite FKs from ReminderLog)
  @@unique([id, shopId])
  @@index([shopId, enabled])
}

/// Reminder log: tracks sent reminders to prevent duplicates
model ReminderLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId    String
  ruleId    String
  invoiceId String
  /// When the reminder was sent
  sentAt    DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  // Direct Shop FK with CASCADE enables Shop delete to work
  shop    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Composite FKs ensure rule and invoice are from the same shop
  // NoAction: deleting a rule/invoice with logs is rejected (preserves reminder history)
  rule    ReminderRule @relation(fields: [ruleId, shopId], references: [id, shopId], onDelete: NoAction)
  invoice Invoice      @relation(fields: [invoiceId, shopId], references: [id, shopId], onDelete: NoAction)

  // One reminder per rule per invoice (prevents duplicate sends)
  @@unique([ruleId, invoiceId])
  @@index([invoiceId])
  @@index([shopId])
}

// =============================================================================
// AUDIT LOG
// =============================================================================

/// Audit event: tracks significant actions for compliance
model AuditEvent {
  id     String   @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId String
  /// Who performed the action (user ID, "system", "webhook")
  actor  String
  /// Type of action (e.g. "invoice.created", "payment.matched", "account.hold")
  type   String
  /// Additional data specific to the event type
  data   Json
  /// When the event occurred
  at     DateTime @default(now()) @db.Timestamptz(3)

  // Relations (onDelete: CASCADE - audit events are shop-specific)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, at])
  @@index([shopId, type])
}

// =============================================================================
// S6 QUEUE SUPPORT TABLES
// =============================================================================

/// Webhook dedupe table for idempotent processing (S6)
/// Stores processed webhook IDs to prevent duplicate processing when
/// Shopify retries webhooks or the drain reprocesses messages.
///
/// Note: This table is created by the S6 migration, not Prisma.
/// It's included here to keep schema.prisma in sync with the database.
model S6ProcessedWebhook {
  webhookId   String   @id @map("webhook_id")
  topic       String
  resourceGid String   @map("resource_gid")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([processedAt])
  @@map("s6_processed_webhooks")
}

/// Bulk operations tracking table (S6)
/// Records the type of each bulk operation at launch so the finish webhook
/// knows how to process the JSONL result.
///
/// S10 additions: byte_offset for chunked JSONL processing, completed_at.
/// S10b additions: origin, reconcile_stage for sequential reconcile chaining,
///                 failure_count for DLQ threshold (not progress iterations),
///                 chunk_size for growing range window.
///
/// Note: This table is created by the S6 migration, not Prisma.
/// It's included here to keep schema.prisma in sync with the database.
model S6BulkOperation {
  bulkOperationId String    @id @map("bulk_operation_id")
  shop            String
  bulkType        String    @map("bulk_type")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  byteOffset      BigInt    @default(0) @map("byte_offset")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  origin          String    @default("webhook")
  reconcileStage  String?   @map("reconcile_stage")
  failureCount    Int       @default(0) @map("failure_count")
  chunkSize       Int       @default(524288) @map("chunk_size")

  @@map("s6_bulk_operations")
}

// =============================================================================
// S8 TAGGED CUSTOMER & DRAFT ORDER TRACKING
// =============================================================================

/// Tagged customer tracking table (S8)
/// Stores minimal customer data for tag-based buyer account rules.
///
/// DPDP compliance: Only stores customer GID and tags array by default.
/// Phone and address are NEVER stored.
///
/// Tag activation design:
/// - tag_active is separate from BuyerAccount.holdState
/// - Tag sync NEVER touches holdState - that belongs to credit logic alone
/// - When tag removed: set tag_active=false, record tag_deactivated_at
/// - When tag re-added: set tag_active=true, clear tag_deactivated_at
///
/// Reserved PII fields (email, displayName):
/// - Requires Protected Customer Data approval (Level 1 + Email/Name fields)
/// - Gated by CUSTOMER_PII_FIELDS env var (default: off)
/// - Always NULL until approval is granted and flag is enabled
///
/// When a customer gains or loses the configurable tag (stored in AccountSource),
/// the corresponding BuyerAccount (kind=TAGGED_CUSTOMER) is created or updated.
///
/// Precedence rule: When a customer is both a B2B company contact AND tagged,
/// the COMPANY BuyerAccount takes precedence for order mapping. The tagged
/// customer record is still tracked but won't create a duplicate BuyerAccount.
///
/// S22: FK to Shop with ON DELETE CASCADE enables automatic deletion on shop/redact.
model S8TaggedCustomer {
  id              String    @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId          String    @map("shop_id")
  /// Shopify Customer GID (e.g., "gid://shopify/Customer/123")
  customerId      String    @map("customer_id")
  /// Customer tags as JSON array (e.g., ["net-terms", "wholesale"])
  /// Only the tags are stored for rule matching; no other customer data
  tags            Json      @default("[]")
  /// Whether the customer currently has a matching buyer tag
  /// Separate from BuyerAccount.holdState - tag sync never touches credit hold
  tagActive       Boolean   @default(false) @map("tag_active")
  /// When the customer lost the matching tag (NULL if tagActive=true)
  tagDeactivatedAt DateTime? @map("tag_deactivated_at") @db.Timestamptz(3)
  /// Reserved: customer email, requires Protected Customer Data approval
  /// Always NULL until CUSTOMER_PII_FIELDS=1 is set after approval
  email           String?
  /// Reserved: customer display name, requires Protected Customer Data approval
  /// Always NULL until CUSTOMER_PII_FIELDS=1 is set after approval
  displayName     String?   @map("display_name")
  /// When the record was created
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// When the record was last updated
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  // One record per customer per shop
  @@unique([shopId, customerId])
  @@index([shopId, tagActive])
  @@map("s8_tagged_customers")
}

/// Draft order tracking table (S8)
/// Tracks draft orders with payment terms for pending credit exposure.
///
/// DPDP compliance: Only stores draft order GID, buyer account reference,
/// total amount, and payment terms state. No PII fields.
///
/// Draft orders are tracked when they have payment terms assigned to a buyer.
/// When a draft order is completed (becomes an Order), it's removed from this
/// table and tracked as an Invoice instead. When deleted, it's removed.
///
/// The pending exposure (sum of tracked draft orders) is used by the credit
/// limit calculation to include uncommitted orders.
///
/// S22: FK to Shop with ON DELETE CASCADE enables automatic deletion on shop/redact.
model S8DraftOrder {
  id             String   @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId         String   @map("shop_id")
  /// Shopify DraftOrder GID (e.g., "gid://shopify/DraftOrder/123")
  draftOrderId   String   @map("draft_order_id")
  /// Reference to BuyerAccount for credit exposure calculation
  buyerAccountId String?  @map("buyer_account_id")
  /// Display name (e.g., "#D1")
  name           String
  /// Total amount in shop currency
  total          Decimal  @db.Decimal(14, 2)
  /// Whether the draft order has payment terms
  hasPaymentTerms Boolean @default(false) @map("has_payment_terms")
  /// Draft order status (open, invoice_sent, completed)
  status         String   @default("open")
  /// When the draft order was created in Shopify
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  /// When the record was last updated
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  // One record per draft order per shop
  @@unique([shopId, draftOrderId])
  @@index([shopId, buyerAccountId])
  @@index([shopId, hasPaymentTerms])
  @@map("s8_draft_orders")
}

// =============================================================================
// S10 DEAD-LETTER QUEUE
// =============================================================================

/// Dead-letter queue for failed messages (S10)
/// Stores messages that exceeded max retry attempts for later review
/// and potential reprocessing.
///
/// Note: This table is created by the S10 migration.
/// It's included here to keep schema.prisma in sync with the database.
model S6DeadLetter {
  id             BigInt   @id @default(autoincrement())
  originalQueue  String   @map("original_queue")
  originalMsgId  String   @map("original_msg_id")
  message        Json
  error          String
  deadLetteredAt DateTime @default(now()) @map("dead_lettered_at") @db.Timestamptz(6)

  @@index([originalQueue, deadLetteredAt(sort: Desc)], map: "idx_s6_dead_letter_queue_time")
  @@map("s6_dead_letter")
}

// =============================================================================
// S10b NIGHTLY RECONCILE
// =============================================================================

/// Order refetch null aggregate (S10b)
/// Counts orders that return null on re-fetch per shop per day.
/// No PII - just (shop, day, count) for monitoring.
/// 90-day retention via pg_cron purge job.
///
/// Note: This table is created by the S10b migration.
model S10bOrderRefetchNull {
  shop  String
  day   DateTime @db.Date
  count Int      @default(1)

  @@id([shop, day])
  @@map("s10b_order_refetch_null")
}

// =============================================================================
// S22 DATA REQUESTS
// =============================================================================

/// GDPR/CCPA data request tracking (S22)
/// Stores customer data export requests from customers/data_request webhook.
/// Merchant downloads pending exports via embedded admin route.
///
/// Delivery path: In-admin download + email notification to shop owner (if configured).
/// Exports are retained for 30 days (DPDP minimisation) then auto-purged by pg_cron.
model S22DataRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()::text"))
  shopId       String    @map("shop_id")
  /// Customer GID (e.g., "gid://shopify/Customer/123")
  customerGid  String    @map("customer_gid")
  /// Shopify's unique request ID from the webhook
  requestId    String    @unique @map("request_id")
  /// When the data request webhook was received
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  /// Request status: pending, completed, downloaded, expired
  status       String    @default("pending")
  /// JSON export of all customer data. NULL before export is generated.
  exportData   Json?     @map("export_data")
  /// When export was generated
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  /// When merchant downloaded the export
  downloadedAt DateTime? @map("downloaded_at") @db.Timestamptz(3)
  /// Expiration timestamp (30 days from creation). Expired exports are purged by pg_cron.
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([shopId, status])
  @@index([shopId, customerGid])
  @@map("s22_data_requests")
}
