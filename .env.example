# Shopify App Configuration
# These are set automatically by `shopify app dev` when running locally
# For Cloudflare Workers deployment, set secrets via `wrangler secret put <NAME>`

# Your Shopify app's API key (from Partner Dashboard)
SHOPIFY_API_KEY=

# Your Shopify app's API secret (from Partner Dashboard)
# NEVER commit the actual value!
SHOPIFY_API_SECRET=

# Your app's public URL
# Local: http://localhost:3000 (CLI provides tunnel URL)
# Production: https://net-terms-receivables.<subdomain>.workers.dev
# NOTE: This is a plain var in wrangler.jsonc, not a secret
SHOPIFY_APP_URL=

# OAuth scopes (comma-separated, no spaces)
# Start with no scopes - add only when features require them
# Protected customer data scopes (read_orders, read_customers) require DPDP form
# NOTE: This is a plain var in wrangler.jsonc, not a secret
SCOPES=

# Optional: Custom shop domain for headless stores
# SHOP_CUSTOM_DOMAIN=

# Sentry error monitoring (optional)
# Get your DSN from https://sentry.io → Project Settings → Client Keys
# Leave empty for local development and CI (Sentry is a no-op without DSN)
SENTRY_DSN=
# Optional: Set trace sample rate (0-1). Default is 0 to stay within Workers Free CPU limits.
SENTRY_TRACES_SAMPLE_RATE=0

# For Cloudflare Workers deployment:
# 1. Create Supabase project (Mumbai, ap-south-1 region for low latency)
# 2. Create Hyperdrive config: wrangler hyperdrive create net-terms-db --connection-string="<SESSION_POOLER_URL>"
# 3. Update wrangler.jsonc with the Hyperdrive ID
# 4. Set secrets:
#    wrangler secret put SHOPIFY_API_KEY
#    wrangler secret put SHOPIFY_API_SECRET
#    wrangler secret put SENTRY_DSN  # (optional)
#    wrangler secret put JOBS_DRAIN_SECRET  # (S10)

# For migrations (CI):
# Set DATABASE_URL_MIGRATIONS as a GitHub Actions secret pointing to
# Supabase's SESSION pooler (port 5432, not the 6543 transaction pooler)

# S10 Queue Drain Authentication
# Used by POST /jobs/drain endpoint. The request must include:
#   Authorization: Bearer <JOBS_DRAIN_SECRET>
# Never commit the actual value! Set via:
#   wrangler secret put JOBS_DRAIN_SECRET
#
# For Supabase pg_cron + pg_net integration, DevOps must also create
# Vault secrets (via Supabase Dashboard or SQL):
#   - jobs_drain_url: Full URL to POST (e.g., https://app.workers.dev/jobs/drain)
#   - jobs_drain_secret: Same value as JOBS_DRAIN_SECRET
JOBS_DRAIN_SECRET=
