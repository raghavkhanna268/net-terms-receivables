{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "net-terms-receivables",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",

  // S10: Cron triggers for queue drain keep-alive
  // Primary drain is via pg_cron + pg_net every minute.
  // This Workers Cron acts as a fallback and keep-alive (every 5 min).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Explicit region placement: run Worker near Supabase Postgres in AWS Mumbai.
  "placement": {
    "region": "aws:ap-south-1"
  },

  // Hyperdrive binding for Supabase Postgres connection pooling
  // Create with: wrangler hyperdrive create net-terms-db --connection-string="<SUPABASE_SESSION_POOLER_URL>"
  // Then replace <YOUR_HYPERDRIVE_ID> with the actual ID from the output
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "df513d372cfe4171a3f27ec48079e4e2",
      // For local dev, point to Supabase session pooler or local Postgres
      // wrangler dev uses this instead of Hyperdrive
      "localConnectionString": "postgresql://postgres:password@localhost:5432/net_terms"
    }
  ],

  // Public environment variables (non-sensitive, ok to commit placeholders)
  "vars": {
    // Must match shopify.app.toml access_scopes exactly. See docs/scopes.md for audit.
    // CI checks this with scripts/check-scope-sync.ts
    "SCOPES": "read_draft_orders,read_all_orders,read_payment_terms,write_companies,write_customers,write_merchant_managed_fulfillment_orders,write_orders,write_payment_customizations,write_validations",
    "SHOPIFY_APP_URL": "https://net-terms-receivables.raghavkhanna.workers.dev",
    // PCD Level 1 (Name, Email): requested/draft, not approved.
    // Enables fetching email and displayName in customer queries.
    // Phone and address are NEVER fetched regardless of this setting.
    "CUSTOMER_PII_FIELDS": "1",
    // S21: App handle for managed pricing page URL.
    // Must match the app name in Partner Dashboard exactly (lowercase, hyphens).
    // Used to build upgrade URL: https://admin.shopify.com/store/{store}/charges/{app_handle}/pricing_plans
    "APP_HANDLE": "net-terms-receivables-1",
    // S21: Plan gating enforcement. Set to "1" or "true" to enable.
    // When OFF (default): Plan resolution, banner, usage work but limits are not enforced.
    // When ON: Over-limit accounts are gated (gated_at set) and blocked from operations.
    "PLAN_GATING_ENFORCED": "false",
    // T2: Plan resolution source. Defaults to "admin_installation" (today's behavior).
    // Set to "partner_api" to resolve plans from the Partner API (Shopify App Pricing).
    // Requires the Partner API secrets below to be set; otherwise falls back to admin.
    "PLAN_SOURCE": "admin_installation"
  },

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true

  // Secrets are configured via wrangler CLI, not in this file:
  // wrangler secret put SHOPIFY_API_KEY
  // wrangler secret put SHOPIFY_API_SECRET
  // wrangler secret put REMINDER_UNSUBSCRIBE_SECRET
  // wrangler secret put REMINDER_UNSUBSCRIBE_SECRET_PREVIOUS  # optional, for key rotation
  //
  // T2 Partner API secrets (required when PLAN_SOURCE="partner_api"):
  // wrangler secret put SHOPIFY_PARTNER_API_TOKEN
  // wrangler secret put SHOPIFY_PARTNER_ORG_ID
  // wrangler secret put SHOPIFY_APP_GID  # format: gid://shopify/App/{id}
}
