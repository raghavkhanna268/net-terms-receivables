# Cloudflare Workers local development secrets
# Copy to .dev.vars and fill in values (never commit .dev.vars)

# Shopify App credentials (from Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=

# Sentry error monitoring (optional, leave empty for local dev)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# S18: Resend email provider (optional, leave both empty to disable reminders)
# Get API key from Resend Dashboard > API Keys
# Never commit the real key - these are wrangler secrets in production
RESEND_API_KEY=
# Sender address - must be a verified domain in Resend (e.g. noreply@yourdomain.com)
RESEND_FROM=
# Pre-launch recipient allowlist - comma-separated emails allowed to receive
# payment reminders, catch-up reminders, and data-request notification emails.
# When set, sends only to listed addresses; when empty or unset, blocks ALL emails (fail closed).
# To disable the allowlist guard for launch, set RESEND_RECIPIENT_ALLOWLIST_ENFORCED=false.
RESEND_TEST_RECIPIENTS=ops@test-example.com

# Off switch for the recipient allowlist guard. Defaults to enforced (true).
# Set to the exact string "false" to disable the guard and allow all recipients.
# Any other value (including unset, empty, "False", "0", "no", whitespace, "true")
# keeps the guard ENFORCED (fail closed).
# IMPORTANT: Flipping this to "false" in production is a launch step requiring
# the owner's sign-off. Do not disable without explicit approval.
# NOTE: There is no diagnostics output for this flag (Actions cannot read Worker
# secret values). Verification at the launch flip is a live send to a non-allowlisted
# test inbox, performed by DevOps after setting the flag, only with owner approval.
# RESEND_RECIPIENT_ALLOWLIST_ENFORCED=false

# Database connection for local development
# Option 1: Local Postgres (recommended for offline dev)
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:password@localhost:5432/net_terms

# Option 2: Supabase session pooler (for testing against real DB)
# Get this from Supabase Dashboard > Project Settings > Database > Connection string (Session mode, port 5432)
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres.zpgwwepehatywxeizowd:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
